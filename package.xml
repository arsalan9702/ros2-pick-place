<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>pick_place_demo</name>
  <version>0.1.0</version>
  <description>Repeated pick-and-place with a Franka Panda in MoveIt 2, with cycle-time and success-rate reporting.</description>
  <maintainer email="arsalansayed9702@gmail.com">Arsalan Sayed</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>moveit_ros_planning_interface</depend>
  <depend>geometry_msgs</depend>
  <depend>moveit_msgs</depend>
  <depend>shape_msgs</depend>

  <exec_depend>moveit_resources_panda_moveit_config</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
